# Copy to .env and fill in. Never commit .env.
PORT=4000
NODE_ENV=development

# Local Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://store:store@localhost:5432/store
# Separate database used ONLY by automated tests (tables get wiped!)
TEST_DATABASE_URL=postgres://store:store@localhost:5432/store_test

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Aiven / hosted Postgres needs SSL. Local: leave false.
DATABASE_SSL=false
# Optional: paste Aiven's CA certificate (ca.pem contents) to verify the connection
DATABASE_CA=

# Used by `npm run seed` to create the first admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
